# SQLite dev database (gitignored). For Supabase/Postgres, replace with the
# connection string and switch provider to "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Strava API app — create at https://www.strava.com/settings/api
# Authorization Callback Domain: localhost (dev) or your domain (prod)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Garmin: no public self-serve API. See README "Garmin" section —
# use /import file upload (.fit/.tcx/.gpx) until developer approval is granted.
