# Postgres (Supabase). Use the pooler connection string, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# Public origin of the deployed app (no trailing slash). Required on Vercel so
# OAuth redirect_uri and post-callback redirects use the public domain, e.g.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=

# Strava API app — create at https://www.strava.com/settings/api
# Authorization Callback Domain: localhost (dev) or your domain (prod)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Garmin: no public self-serve API. See README "Garmin" section —
# use /import file upload (.fit/.tcx/.gpx) until developer approval is granted.

# Your local timezone (Vercel reserves TZ, so the app sets it from this at boot).
APP_TIMEZONE=America/New_York
